NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_PLACES_API_KEY=
# Public, referrer-restricted MapTiler key for the Day Map basemap.
# Get a free key at https://www.maptiler.com/ — the map is optional; the app
# works without it (the map view shows a "not configured" fallback).
NEXT_PUBLIC_MAPTILER_KEY=

# Transactional email for trip invitations (Brevo — free tier, 300 emails/day).
# Verify a single sender address in Brevo (no custom domain needed), then set
# EMAIL_FROM to that exact address. Invites still work without these — they just
# won't send an email; the invitee sees them on their dashboard after signing up.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Travelando
# Absolute base URL used to build invite links (no trailing slash).
# e.g. https://travelando.vercel.app
NEXT_PUBLIC_APP_URL=
